# Point this at the real AMAN FastAPI backend. If unset, the app defaults to
# http://127.0.0.1:8000 (the standard local backend address) -- it never
# silently falls back to mock/fixture data. To use the dev fixture for UI
# work with no backend running, also set VITE_ENABLE_DEV_FIXTURE=true below;
# this flag is only honored in `npm run dev`, never in a production build.
VITE_API_URL=http://localhost:8000
# VITE_ENABLE_DEV_FIXTURE=true
