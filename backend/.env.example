# AMAN Sentinel Phase 4 backend -- environment variables.
#
# Copy this file to `backend/.env` and fill in real values for your
# environment. `backend/.env` is gitignored (see repo root .gitignore) --
# never commit it. No real credentials are present in this example file.
#
# This file documents every env var the backend (backend/main.py,
# backend/pipeline_wrapper.py) and the LLM provider layer it calls into
# (phase3/llm_provider.py) actually read. Nothing here is loaded
# automatically by the app today (no python-dotenv call is wired in) --
# export these in your shell, your process manager, or your container
# definition before starting uvicorn.

# --- LLM provider selection (phase3/llm_provider.get_default_provider) ---

# "ollama" (default) | "vllm" | "mock"
#   ollama -> OllamaProvider if reachable at OLLAMA_HOST, else MockProvider.
#             This is today's real, working path. Default model is
#             qwen2.5:7b-instruct (the intended primary verifier for this
#             submission); override with OLLAMA_MODEL below if needed.
#   vllm   -> VLLMProvider, pointed at VLLM_ENDPOINT. This is the intended
#             FUTURE AMD/ROCm production path (see
#             phase4/reports/amd_deployment_instructions.md) and has NOT
#             been tested against real AMD hardware -- there is none in
#             this sandbox. Selecting it today will fail at generate()
#             time unless VLLM_ENDPOINT points at a real, running
#             OpenAI-compatible vLLM server.
#   mock   -> MockProvider explicitly (deterministic canned responses, no
#             network/model). Useful for CI/tests.
LLM_PROVIDER=ollama

# Read by phase3.llm_provider.OllamaProvider (used when LLM_PROVIDER=ollama,
# the default). Falls back to http://localhost:11434 if unset.
OLLAMA_HOST=http://localhost:11434
# Model served by Ollama. Defaults to qwen2.5:7b-instruct (the intended
# primary verifier) if unset. Run `ollama pull qwen2.5:7b-instruct` first.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Used only when LLM_PROVIDER=vllm (phase3.llm_provider.VLLMProvider).
# Example placeholder only -- replace with a real vLLM OpenAI-compatible
# endpoint once an AMD Developer Cloud instance has been provisioned
# (see phase4/reports/amd_deployment_instructions.md). NOT functional today.
VLLM_ENDPOINT=http://REPLACE-WITH-REAL-ROCM-HOST:8000
# Optional bearer token for the vLLM endpoint, if it enforces one.
# NEVER put a real key in this checked-in .env.example file.
VLLM_API_KEY=replace-with-a-real-api-key-in-your-local-.env-only
# Optional: model name served by vLLM. Defaults to Qwen/Qwen2.5-7B-Instruct
# (see phase3/reports/llm_model_selection.md) if unset.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
